# =============================================================
# Nusuk Cards Operations Dashboard — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
#
# For Vercel deployment, add these under:
#   Project Settings → Environment Variables
# =============================================================


# -------------------------------------------------------------
# Supabase (REQUIRED)
# Find these in: Supabase Dashboard → Project Settings → API
# -------------------------------------------------------------

# Your project URL, e.g. https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# Public anon key — safe to expose in the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key — server-side only, KEEP SECRET
# Used for admin operations that bypass RLS
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key


# -------------------------------------------------------------
# Application (REQUIRED for production)
# Set this to your Vercel deployment URL in production,
# e.g. https://nusuk.vercel.app
# -------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
